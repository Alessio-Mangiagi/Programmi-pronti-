{
  "name": "ocr-webapp-paddleocr",
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "concurrently --kill-others \"tsx watch server.ts\" \"vite --port 5179\"",
    "build": "npm run typecheck && vite build",
    "start": "tsx server.ts",
    "start:prod": "node tools/avvio-prod.mjs",
    "harness": "tsx tools/harness.ts",
    "preview": "vite preview",
    "verifica-ui": "node tools/verifica-ui.mjs",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.server.json --noEmit",
    "test": "vitest run",
    "baseline:aggiorna": "cross-env AGGIORNA_BASELINE=1 vitest run server/__tests__/baseline.test.ts",
    "lint": "eslint .",
    "check": "npm run typecheck && npm run lint && npm test"
  },
  "dependencies": {
    "cors": "^2.8.5",
    "docx": "^9.8.1",
    "express": "^5.2.1",
    "mammoth": "^1.12.0",
    "pdfjs-dist": "^4.7.76",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-markdown": "^9.0.1",
    "remark-gfm": "^4.0.0",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "xlsx-js-style": "^1.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.1",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^5.2.0",
    "concurrently": "^8.2.2",
    "cross-env": "^10.1.0",
    "eslint": "^10.10.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.12.0",
    "playwright-core": "^1.62.1",
    "tsx": "^4.15.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.70.0",
    "vite": "^7.3.6",
    "vitest": "^5.0.0"
  },
  "engines": {
    "node": ">=20"
  },
  "overrides": {
    "qs": "^6.16.0"
  }
}
