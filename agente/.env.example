# Porta backend
PORT=3001

# --- Rete / Sicurezza ---
# Interfaccia di ascolto. Default solo locale (sicuro). Per uso in LAN: 0.0.0.0
BIND_HOST=127.0.0.1
# Origini browser ammesse (CORS), separate da virgola
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Limite richieste/minuto per IP su query e analyze
RATE_MAX=60
# Fidati di X-Forwarded-For SOLO se dietro un reverse-proxy fidato.
# Vuoto/false = non fidarsi (IP di audit e rate-limit NON spoofabili). Altrimenti:
# numero di hop (es. 1) oppure 'true'/lista IP-subnet. NON impostare se esposto diretto.
TRUST_PROXY=
# Anti brute-force login: dopo N errori l'utente è bloccato per M minuti
LOGIN_MAX_FAILS=5
LOGIN_LOCK_MIN=15

# --- Autenticazione multi-utente ---
# Auth attiva di default (login per-utente + cookie). Per sviluppo monoutente: AUTH_ENABLED=0
AUTH_ENABLED=1
# Admin iniziale creato al PRIMO avvio (se non esistono utenti).
# Se ADMIN_PASSWORD è vuoto: default 'cambiami', con OBBLIGO di cambio al 1° login.
# Se il server è ESPOSTO in rete (BIND_HOST!=127.0.0.1) con password di default,
# l'avvio viene RIFIUTATO: imposta qui una password robusta.
ADMIN_USER=admin
ADMIN_PASSWORD=
# Durata sessione di login (giorni)
SESSION_TTL_DAYS=7
# Metti 1 SOLO se il server è dietro HTTPS (cookie con flag Secure).
# Attiva anche HSTS: annunciarlo su un host raggiunto in http lascerebbe i
# client fuori dalla LAN, quindi resta legato a questa scelta.
COOKIE_SECURE=0

# --- Gate SSO del Portale Suite ---
# Lo stesso gate di vite.config.ts ora gira anche nel backend, cosi' la
# modalita' di produzione (npm start, che serve dist/ senza passare da Vite)
# non resta scoperta. Vuoto = default.
#   COSEDIL_PORTAL   url del portale (default http://localhost:8080)
#   COSEDIL_SSO=off  disattiva del tutto il gate
#   COSEDIL_SSO_FAIL=open  portale irraggiungibile -> passa comunque
#                          (default: closed, cioe' non entra nessuno)
COSEDIL_PORTAL=
COSEDIL_SSO=
COSEDIL_SSO_FAIL=

# --- Backup (npm run backup) ---
# Salva app.db (copia consistente via VACUUM INTO), secret.enc e .env in una
# cartella datata. ATTENZIONE: il backup contiene MASTER_PASSWORD in chiaro.
BACKUP_DIR=
BACKUP_KEEP=14

# --- Header di sicurezza ---
# Content-Security-Policy della pagina. Vuoto = policy predefinita (script solo
# dall'app, font Google, nessun frame). Scrivi qui una policy completa per
# sostituirla, oppure CSP=off per disattivarla (sconsigliato).
CSP=
# Millisecondi di attesa in chiusura prima di forzare l'uscita.
# Serve a non restare appesi a un report da 100k righe o a una chiamata LLM.
SHUTDOWN_TIMEOUT_MS=10000

# --- Concorrenza LLM ---
# Quante chiamate all'LLM insieme (le altre fanno la coda). Protegge Claude/Ollama.
LLM_CONCURRENCY=3

# --- Scheduler / persistenza (multi-utente, autonomia) ---
# DB applicativo SQLite (utenti, connessioni cifrate, job, run). Default: ./app.db
APP_DB_PATH=
# Cartella dove lo scheduler deposita i report .xlsx. Default: ./reports
REPORTS_DIR=
# Timeout massimo di un job pianificato (ms): oltre → run in errore, coda avanti
JOB_TIMEOUT_MS=600000
# Retention: quante esecuzioni (+ file .xlsx) conservare per ogni job
RUNS_KEEP=20
# Catch-up: al riavvio recupera un'esecuzione saltata mentre era spento (0=off)
SCHEDULER_CATCHUP=1
SCHEDULER_CATCHUP_WINDOW_MIN=1440

# Ollama (LLM locale, default) — 100% offline, nessuna chiave
OLLAMA_BASE=http://localhost:11434
# Se Ollama e' locale e spento, il backend lo avvia da solo (ollama serve).
# Metti 0 per disattivare l'avvio automatico.
OLLAMA_AUTOSTART=1
OLLAMA_MODEL=gemma4:12b
# Routing per COMPITO (vedi MODELLI-AI.md): modello GRANDE per pianificare i
# report e commentare i risultati; vuoto = usa sempre OLLAMA_MODEL.
# Con molta VRAM (es. 96GB): OLLAMA_MODEL=qwen3-coder:30b + OLLAMA_MODEL_REASON=gpt-oss:120b
# (e imposta OLLAMA_MAX_LOADED_MODELS=2 nell'ambiente di Ollama)
OLLAMA_MODEL_REASON=

# --- AI locale alternativa: qualsiasi server OpenAI-compatibile ---
# LM Studio, llama.cpp server, vLLM, LocalAI, Jan, text-generation-webui...
# Lascia LOCAL_LLM_BASE vuoto per disattivare il provider "local".
# Esempi base URL: LM Studio http://localhost:1234 | llama.cpp http://localhost:8080
LOCAL_LLM_BASE=
LOCAL_LLM_MODEL=local-model
# Come OLLAMA_MODEL_REASON ma per il server OpenAI-compatibile (vuoto = nessuno split)
LOCAL_LLM_MODEL_REASON=
# Chiave opzionale (i server locali di solito NON la richiedono)
LOCAL_LLM_API_KEY=
# Timeout richiesta LLM locale/Ollama in ms (modelli lenti)
LOCAL_LLM_TIMEOUT_MS=120000

# Quale LLM usare di default: ollama | local | claude
DEFAULT_LLM=ollama
# Modello Claude (default aggiornato). Alternative: claude-sonnet-4-6, claude-opus-4-8.
CLAUDE_MODEL=claude-sonnet-5
# Budget giornaliero token Claude PER UTENTE (input+output). 0 = illimitato.
# Oltre il tetto, l'agente ripiega automaticamente sull'AI locale (protegge il credito).
CLAUDE_DAILY_TOKEN_BUDGET=0
# Ritenta i guasti transitori (429 limite, 529 sovraccarico, rete) e timeout per
# richiesta. In un loop tool-use un solo 529 non ritentato butta via l'intera richiesta.
CLAUDE_MAX_RETRIES=3
CLAUDE_TIMEOUT_MS=120000

# --- FILTRO DI PERTINENZA (anti-spreco credito) ---
# Blocca le domande TROPPO GENERALISTE/fuori ambito (cultura generale, scrittura
# creativa, programmazione, traduzioni, matematica, meteo, chiacchiere) PRIMA di
# chiamare l'LLM a pagamento: il credito Claude non si brucia su richieste che
# non riguardano dati/documenti/operazioni. Le domande sui dati passano sempre.
#   off       = disattivato (tutto passa all'LLM)
#   heuristic = solo regole istantanee a costo zero
#   auto      = regole + (per i casi ambigui) classificatore sul modello LOCALE
#               gratuito (Ollama/endpoint locale). MAI usa Claude per filtrare.
SCOPE_GUARD=auto
# Se il classificatore locale fallisce (modello spento/assente) si mette in pausa
# per questo tempo (ms) e nel frattempo AMMETTE (fail-open): mai bloccare una
# domanda legittima per un problema del filtro.
SCOPE_GUARD_COOLDOWN_MS=60000

# --- Chiave Claude CIFRATA (consigliato) ---
# 1) esegui:  npm run set-key   (cifra la chiave in secret.enc)
# 2) imposta qui la passphrase usata per cifrare:
# NB: la STESSA passphrase cifra anche le CONNESSIONI DB salvate (host/password).
# Senza MASTER_PASSWORD il salvataggio connessioni e i job pianificati sono disattivati.
MASTER_PASSWORD=

# --- Alternativa SOLO sviluppo: chiave in chiaro (sconsigliato) ---
# Usata solo se secret.enc NON esiste.
ANTHROPIC_API_KEY=

# --- SQL Server ---
# encrypt attivo di default; metti true SOLO se usi cert self-signed in locale
MSSQL_ENCRYPT=true
MSSQL_TRUST_CERT=false

# Limite righe per l'ANTEPRIMA in chat (sicurezza)
MAX_ROWS=1000
# Limite righe per gli EXPORT Excel (report / conversazione): analisi su larga scala
EXPORT_MAX_ROWS=200000

# --- SORGENTE MULTIPLA "DB + Excel" (JOIN tra gestionale e fogli Excel) ---
# Le sorgenti vengono COPIATE in una SQLite in-memory: i tetti qui sotto sono
# il freno al consumo di RAM. Oltre il tetto la tabella e' TRONCATA e l'utente
# riceve un avviso (i totali diventano parziali).
MULTI_MAX_ROWS_PER_TABLE=100000
MULTI_MAX_TABLES=40
# Cartelle da cui e' lecito leggere .xlsx indicati per PERCORSO (separate da ;).
# VUOTO = percorsi su disco disabilitati (restano possibili solo gli upload):
# senza allowlist un percorso arbitrario nel body farebbe leggere al server
# qualunque file della macchina. Gli upload dell'utente non passano di qui.
XLSX_ROOTS=

# --- Worker Python per Excel con GRAFICI (opzionale, vedi report-service/) ---
# Se spento/non raggiungibile, il backend ripiega su SheetJS (solo tabelle).
PYREPORT_URL=http://localhost:8000
PYREPORT_TIMEOUT_MS=60000

# --- ANALISI DOCUMENTI (sorgente "Documenti") ---
# Un set = un file SQLite in docsets/. PDF e immagini scansionate richiedono Claude
# (OCR via vision); testo/CSV/Excel funzionano anche senza. I set sono isolati per
# utente; un nome con prefisso '@' (es. @sorvegliati) indica un set CONDIVISO.
# Tetto caratteri di testo salvati per documento; dimensione blocco dei frammenti.
DOC_MAX_CHARS=200000
DOC_CHUNK_CHARS=1500
# Numero massimo di file per singolo upload.
DOCS_MAX_FILES=20

# --- RICERCA SEMANTICA sui documenti (embeddings via Ollama) ---
# 1 = calcola i vettori dei frammenti all'acquisizione (abilita la ricerca
# semantica con citazioni). Se Ollama/il modello embed non ci sono, degrada senza
# errori e resta attiva la sola ricerca full-text (FTS).
DOCS_EMBED=0
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_EMBED_TIMEOUT_MS=60000

# --- WATCHER CARTELLA (acquisizione autonoma) ---
# Se impostata, la cartella viene scandita a intervalli: i file nuovi vengono
# acquisiti nel set condiviso "@<DOCS_WATCH_SET>" e spostati in _processati/
# (o _errori/). Connettiti dall'app con set documenti = "@sorvegliati".
DOCS_WATCH_DIR=
DOCS_WATCH_SET=sorvegliati
DOCS_WATCH_INTERVAL_MS=60000
# Provider LLM per classificazione/estrazione dei documenti sorvegliati (opz.)
DOCS_WATCH_PROVIDER=

# --- AGENTE OPERATIVO SUITE (usa le altre app: scadenzario, OCR, …) ---
# on = l'agente può usare gli strumenti delle app sorelle; off = disattivato.
SUITE_TOOLS=on
# URL del Portale (per avviare on-demand le app spente e verificare l'identità SSO).
COSEDIL_PORTAL=http://localhost:8080
# Override opzionali degli URL delle app (default localhost:<porta di registro>).
# SUITE_SCADENZARIO_URL=http://localhost:5180
# SUITE_OCR_URL=http://localhost:5179
# SUITE_CONFRONTA_URL=http://localhost:5001
# SUITE_DDT_URL=http://localhost:5050
# Timeout chiamate alle app e attesa avvio on-demand (ms).
SUITE_CALL_TIMEOUT_MS=60000
SUITE_LAUNCH_WAIT_MS=25000
# Passi massimi del loop tool-use (limite anti-ciclo).
AGENT_MAX_STEPS=8
# Allegati in chat (modalità agente): numero massimo e dimensione per file (MB).
AGENT_MAX_FILES=6
AGENT_MAX_FILE_MB=15
# Memoria della conversazione passata all'agente: quanti turni e quanti caratteri
# per turno. Alzarli migliora i follow-up ma allunga il prompt di OGNI passo.
AGENT_HISTORY_TURNS=8
AGENT_HISTORY_CHARS=2000
# Azioni di scrittura proposte e in attesa di conferma: validità (ms) e tetto di
# proposte tenute in memoria. Scaduta la finestra va richiesta di nuovo all'agente.
AGENT_ACTION_TTL_MS=300000
AGENT_ACTION_MAX_PENDING=500
# Limite body JSON per le rotte NORMALI. Tenerlo stretto: il parser gira prima
# del gate di auth, quindi un limite grande qui vuol dire lasciar allocare quei
# MB a chiunque raggiunga la porta, anche senza credenziali.
JSON_BODY_LIMIT=1mb
# Limite per le sole rotte con allegati (/api/connect, /api/docs/upload,
# /api/agent, /api/agent/stream): li' il parser gira DOPO l'autenticazione.
# Base64 = +33% sul peso dei file.
JSON_UPLOAD_LIMIT=60mb

# --- PRESTAZIONI ---
# Sezioni del report Excel eseguite in parallelo (il semaforo LLM_CONCURRENCY
# resta comunque il tetto per le chiamate AI).
REPORT_CONCURRENCY=4
# Documenti acquisiti in parallelo durante l'upload.
DOCS_INGEST_CONCURRENCY=3
# Cache dell'introspezione per i DB di rete (ms): riconnessioni istantanee allo
# stesso DB. «Aggiorna schema» la bypassa sempre. 0 = tempo reale a ogni connect.
SCHEMA_CACHE_TTL_MS=600000
# Cache dello stato (online/spenta) delle app della suite (ms).
SUITE_HEALTH_TTL_MS=30000
# Selezione tabelle sui DB grandi: soglia oltre cui scatta, quante tenerne e per
# quanto ricordare la scelta (la stessa domanda non ripaga una chiamata LLM).
# La selezione gira sempre sul modello LOCALE gratuito, mai su Claude.
TABLE_SELECT_THRESHOLD=25
TABLE_SELECT_KEEP=12
TABLE_SELECT_CACHE_MS=600000
# Tetto di tempo per un'intera analisi (generazione + retry + esecuzioni). Oltre,
# si smette di ritentare e si restituisce il miglior esito disponibile.
ANALYSIS_BUDGET_MS=90000
# Storico iniettato nei prompt di analisi: caratteri per domanda e per risposta.
HISTORY_Q_CHARS=300
HISTORY_A_CHARS=300
