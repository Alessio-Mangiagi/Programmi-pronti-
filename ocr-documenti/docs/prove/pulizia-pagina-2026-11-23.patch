+# ── Pulizia della pagina prima dell'OCR ─────────────────────────────────────
+# Richiesta del 23/11/2026 («migliorare la scansione»): le scansioni storte, con lo sfondo
+# grigio o col retino si leggono peggio. Passi, ognuno applicato SOLO se la pagina ne ha
+# bisogno (una pagina pulita resta identica, byte per byte):
+# - raddrizza: angolo da -3° a +3° che rende più "a righe" il profilo orizzontale del testo;
+#   si gira solo oltre 0,25° e se il guadagno è netto, su una tela allargata (niente tagli);
+# - retino: puntini delle celle ombreggiate tolti (togli_retino);
+# - sfondo: sfondo stimato con una chiusura morfologica (toglie il testo, resta la carta) e
+#   diviso via: carta grigia, ingiallita o con ombre torna bianca, il testo resta nero;
+#   solo se almeno il 5% della carta è sotto il bianco (235).
+# Provato e tolto il 23/11/2026: stirare il contrasto dell'inchiostro sbiadito (106 pagine
+# del banco toccate, voci esatte 798 → 775: PaddleOCR legge meglio l'immagine com'è).
+# PADDLE_PULIZIA = passi separati da virgole ("" o "0" = spenta); lo decide server/config.ts
+# e lo passa a ogni worker. Ogni passo cambia la lettura: la chiave della cache OCR porta i
+# passi e VERSIONE_PULIZIA (server/config.ts), da alzare quando si cambia questo codice.
+# La stessa immagine pulita vale per OCR, griglia della tabella e celle rilette: le funzioni
+# sono deterministiche, quindi le coordinate dei blocchi e delle celle coincidono.
+PULIZIA = {p.strip() for p in os.environ.get("PADDLE_PULIZIA", "").split(",") if p.strip() not in ("", "0")}
+ANGOLO_MAX = 3.0          # gradi: oltre, la pagina è "di traverso" e ci pensa ocr_orientato
+ANGOLO_MIN = 0.25         # sotto, la storta non disturba l'OCR e girare sfoca per niente
+GUADAGNO_RADDRIZZA = 1.15  # il profilo raddrizzato deve essere almeno il 15% più "a righe"
+
+
+def angolo_storto(img):
+    """Gradi (antiorari, come cv2.getRotationMatrix2D) che raddrizzano le righe del testo, o 0.
+    Sull'immagine ridotta a ~1200 px: varianza del profilo orizzontale dei pixel d'inchiostro,
+    prima ogni 0,25°, poi ogni 0,05° attorno al migliore."""
+    import cv2
+    import numpy as np
+    s = 1200.0 / max(img.shape)
+    piccola = cv2.resize(img, None, fx=s, fy=s, interpolation=cv2.INTER_AREA) if s < 1 else img
+    _, bw = cv2.threshold(piccola, 0, 255, cv2.THRESH_BINARY_INV + cv2.THRESH_OTSU)
+    h, w = bw.shape
+    centro = (w / 2, h / 2)
+
+    def punteggio(a):
+        if a == 0:
+            r = bw
+        else:
+            r = cv2.warpAffine(bw, cv2.getRotationMatrix2D(centro, a, 1.0), (w, h), flags=cv2.INTER_NEAREST, borderValue=0)
+        return float(np.var(r.sum(axis=1, dtype=np.float64)))
+
+    base = punteggio(0)
+    grossi = {a: punteggio(a) for a in np.arange(-ANGOLO_MAX, ANGOLO_MAX + 1e-9, 0.25)}
+    a0 = max(grossi, key=grossi.get)
+    fini = {a: punteggio(a) for a in np.arange(a0 - 0.25, a0 + 0.25 + 1e-9, 0.05)}
+    migliore = max(fini, key=fini.get)
+    if abs(migliore) < ANGOLO_MIN or base <= 0 or fini[migliore] < base * GUADAGNO_RADDRIZZA:
+        return 0.0
+    return float(round(migliore, 2))
+
+
+def pulisci_sfondo(img):
+    """Carta grigia o con ombre → bianca (divisione per lo sfondo stimato); None se non serve."""
+    import cv2
+    import numpy as np
+    k = max(15, (min(img.shape) // 60) | 1)           # ~55 px su una pagina da 3300: più largo del tratto
+    fondo = cv2.morphologyEx(img, cv2.MORPH_CLOSE, cv2.getStructuringElement(cv2.MORPH_RECT, (k, k)))
+    if np.percentile(fondo, 5) >= 235:
+        return None
+    return cv2.divide(img, fondo, scale=255)
+
+
+# Retino (celle ombreggiate a puntini: allegato A di Progetto Costruzioni Ragusana): i puntini
+# sono macchie di 1-4 pixel, fittissime (≈37.000 sulla pag. 49); cifre, lettere e virgole sono
+# macchie molto più grandi. Misura del 23/11/2026 sulla densità di puntini (finestra 41×41):
+# pagina col retino → il 24% della superficie sopra il 2%; pagine pulite (GFM, PF Future,
+# Progetto pag. 3) → meno dello 0,4%, con massimi isolati al 3-4%.
+RETINO_PUNTINO = 6          # pixel: macchie fino a questa area sono puntini del retino
+RETINO_DENSITA = 0.03       # zona col retino: più del 3% dei pixel attorno sono puntini
+RETINO_QUOTA = 0.02         # il passo parte solo se la zona col retino copre il 2% della pagina
+
+
+def togli_retino(img):
+    """Puntini del retino cancellati (bianchi) dentro le zone fitte di puntini; None se la pagina
+    non ha retino. Fuori da quelle zone non si tocca niente: un punto o una virgola isolati del
+    testo normale restano dove sono, e nelle zone col retino le virgole sono più grandi di 6 px."""
+    import cv2
+    import numpy as np
+    nero = (img < 160).astype(np.uint8)
+    _, etichette, stat, _ = cv2.connectedComponentsWithStats(nero, connectivity=8)
+    piccoli = stat[:, cv2.CC_STAT_AREA] <= RETINO_PUNTINO
+    piccoli[0] = False                                   # 0 = sfondo, non è una macchia
+    puntini = piccoli[etichette]
+    densita = cv2.boxFilter(puntini.astype(np.float32), -1, (41, 41))
+    zona = densita > RETINO_DENSITA
+    if zona.mean() < RETINO_QUOTA:
+        return None
+    zona = cv2.dilate(zona.astype(np.uint8), np.ones((15, 15), np.uint8)).astype(bool)
+    out = img.copy()
+    out[puntini & zona] = 255
+    return out
+
+
+def ruota_senza_tagli(img, gradi):
+    """Pagina girata di `gradi` (antiorari) su una tela allargata quanto serve, sfondo bianco.
+    Girarla dentro la stessa cornice tagliava gli angoli (~10 px ai bordi per mezzo grado): le
+    tabelle che arrivano al margine perdevano le linee esterne e la griglia non si trovava più
+    (prima prova del 23/11/2026: Jonico 32 → 7 voci esatte, World service 7 → 0)."""
+    import cv2
+    import numpy as np
+    h, w = img.shape
+    m = cv2.getRotationMatrix2D((w / 2, h / 2), gradi, 1.0)
+    cos, sin = abs(m[0, 0]), abs(m[0, 1])
+    nw, nh = int(np.ceil(h * sin + w * cos)), int(np.ceil(h * cos + w * sin))
+    m[0, 2] += nw / 2 - w / 2
+    m[1, 2] += nh / 2 - h / 2
+    return cv2.warpAffine(img, m, (nw, nh), flags=cv2.INTER_CUBIC, borderValue=255)
+
+
+def prepara_pagina(path):
+    """(percorso da leggere, temporaneo?) con i passi di PULIZIA che servono a questa pagina.
+    Nessun passo utile → il file originale, intatto."""
+    if not PULIZIA:
+        return path, False
+    try:
+        import cv2
+        import numpy as np
+    except ImportError:
+        return path, False
+    img = cv2.imdecode(np.fromfile(path, dtype=np.uint8), cv2.IMREAD_GRAYSCALE)
+    if img is None:
+        return path, False
+    fatti = []
+    if "raddrizza" in PULIZIA:
+        a = angolo_storto(img)
+        if a:
+            img = ruota_senza_tagli(img, a)
+            fatti.append(f"raddrizzata {a:+.2f}°")
+    if "retino" in PULIZIA:
+        out = togli_retino(img)
+        if out is not None:
+            img = out
+            fatti.append("retino")
+    if "sfondo" in PULIZIA:
+        out = pulisci_sfondo(img)
+        if out is not None:
+            img = out
+            fatti.append("sfondo")
+    if not fatti:
+        return path, False
+    import tempfile
+    fd, pulita = tempfile.mkstemp(suffix=".png")
+    os.close(fd)
+    cv2.imencode(".png", img)[1].tofile(pulita)
+    print(f"[worker] pagina pulita: {', '.join(fatti)}", file=sys.stderr)
+    return pulita, True
+
