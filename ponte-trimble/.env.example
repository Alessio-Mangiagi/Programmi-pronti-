# ── Server ────────────────────────────────────────────────
PORT=3011
HOST=127.0.0.1              # 0.0.0.0 solo se l'app deve rispondere in LAN
MAX_PDF_MB=40
FORMATO_DEFAULT=fieldview       # fieldview | xlsx | csv | json
TRADUTTORE_DEFAULT=pcq-controlli
# Cartella con i traduttori forniti da terzi (un file .js per traduttore).
# Vuota = si usano solo quelli in src/pipeline/traduttori/.
TRADUTTORI_DIR=

# ── SSO della suite (shared/sso) ──────────────────────────
COSEDIL_SSO=on              # off = gate disattivato (sviluppo)
COSEDIL_PORTAL=http://localhost:8080
COSEDIL_SSO_FAIL=closed     # open = portale giu' -> app comunque usabile

# ── Destinazione ──────────────────────────────────────────
DESTINAZIONE=fieldview          # fieldview (SOAP) | connect (REST) | nessuna

# ── Trimble Viewpoint Field View (API SOAP) ───────────────
FIELDVIEW_URL=https://eu.fieldview.trimble.com/FieldViewWebServices/WebServices/XML/API_FormsServices.asmx
FIELDVIEW_NS=https://localhost.priority1.uk.net/Priority1WebServices/XML
FIELDVIEW_SOAP=1.1              # 1.1 (SOAPAction) oppure 1.2
FIELDVIEW_TOKEN=
# Valori predefiniti di AddForm: la richiesta API puo' sovrascriverli
FIELDVIEW_FORM_TEMPLATE_ID=
FIELDVIEW_ORGANISATION_ID=
FIELDVIEW_PERSON_ID=
FIELDVIEW_PROJECT_ID=
FIELDVIEW_ELEMENT_ID=
FIELDVIEW_TIMEOUT_MS=30000

# ── Trimble Connect (REST, deposito file) ─────────────────
# VERIFICARE gli URL sul prodotto Trimble in uso (Connect / e-Builder / Viewpoint):
# questi sono i default di Trimble Connect, non valgono per gli altri prodotti.
TRIMBLE_TOKEN_URL=https://id.trimble.com/oauth/token
TRIMBLE_API_BASE=https://app.connect.trimble.com/tc/api/2.0
TRIMBLE_CLIENT_ID=
TRIMBLE_CLIENT_SECRET=
TRIMBLE_SCOPE=
TRIMBLE_PROJECT_ID=
TRIMBLE_FOLDER_ID=
TRIMBLE_TIMEOUT_MS=30000
