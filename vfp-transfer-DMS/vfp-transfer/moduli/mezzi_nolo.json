      ["re:che la\\s*_{2,}(?=\\s*[“\"](?:PROPRIETARIA|NOLEGGIATRICE))", "che la {ragione_sociale}"],
      ["re:(?m)^_{2,}(?=\\s*[“\"](?:PROPRIETARIA|NOLEGGIATRICE))", "{ragione_sociale}"],
