# "><(((º> sabusabu <º)))><"
# Impostazioni e credenziali del trasferimento verso Viewpoint For Projects.
# Copiare questo file in ".env" (oppure compilare le Impostazioni dall'interfaccia, che scrive .env).
# Password, chiavi e ID delle API qui NON restano: alla prima lettura il programma le sposta nella cassaforte
# cifrata (cassaforte.dat) e le cancella da questo file. Il .env non va comunque condiviso ne' caricato su git.
# Valori con spazi o caratteri speciali vanno tra virgolette: CHIAVE="valore con spazi"

# ---------------------------------------------------------------- Viewpoint For Projects (regione UK)
VFP_BASE_URL=https://api-uk.vfp.viewpoint.com
VFP_AUTH_URL=https://identity-uk.team.viewpoint.com/connect/authorize
VFP_TOKEN_URL=https://api-uk.vfp.viewpoint.com/token
# credenziali API fornite da Trimble/Viewpoint (support@4projects.com)
VFP_CLIENT_ID=
VFP_CLIENT_SECRET=
VFP_REDIRECT_URI=http://localhost:8765/callback
# offline_access serve per il rinnovo automatico dell'accesso (indispensabile per la posta automatica)
VFP_SCOPE="vfp.fullaccess offline_access"

# destinazione: project oppure folder, e relativo ID (GUID)
VFP_TARGET_TYPE=project
VFP_TARGET_ID=
VFP_DEFAULT_REVISION=1
# new_revision = aggiunge una revisione se il documento esiste; skip = lo salta
VFP_IF_EXISTS=new_revision
VFP_NOTIFY_EMAIL=false
# campi extra per la creazione dei documenti, in JSON (es. {"OwnerId": "..."})
VFP_DOCUMENT_DEFAULTS="{}"
# file dove il programma salva da solo l'accesso Viewpoint (token): riservato
VFP_TOKEN_CACHE=.vfp_token.json
# indirizzo web di un documento VFP con {id} al posto dell'ID: link diretti da Storico e Flusso posta (facoltativo)
VFP_DOC_URL=
# porta dell'interfaccia web (http://127.0.0.1:8770)
GUI_PORT=8770
# accesso dagli altri PC (facoltativo): 0.0.0.0 + nome del server + certificato HTTPS (file .pem). Vuoto/127.0.0.1 = solo questo PC
GUI_BIND=127.0.0.1
GUI_HOSTNAME=
GUI_TLS_CERT=
GUI_TLS_KEY=

# ---------------------------------------------------------------- posta in arrivo
# true = controlla di continuo le caselle e carica gli allegati in VFP
MAIL_ENABLED=false
# caselle attive, separate da virgola: graph (Microsoft 365), imap, pec
MAIL_SOURCES=
# ogni quanti secondi controllare la posta
MAIL_POLL_SECONDS=120
# cartella VFP (sotto la destinazione) dove finiscono gli allegati; sottocartelle con "/"
MAIL_VFP_FOLDER="Posta in arrivo"
# cartelle della casella email dove spostare i messaggi elaborati
MAIL_DONE_FOLDER="Trasferite a VFP"
MAIL_ERROR_FOLDER="Errori VFP"
# tentativi prima di spostare un messaggio in MAIL_ERROR_FOLDER
MAIL_MAX_ATTEMPTS=3
# estensioni ammesse, separate da virgola (vuoto = elenco predefinito: pdf, dwg, Office senza macro, immagini, zip...).
# Eseguibili, script, pagine web e documenti con macro (exe, js, html, docm, xlsm...) sono sempre bloccati.
MAIL_ALLOWED_EXT=
# ignora le immagini inserite nel testo (loghi, firme)
MAIL_SKIP_INLINE=true
# antepone data e ora di arrivo al nome del documento (evita conflitti tra file omonimi)
MAIL_DATE_PREFIX=true
# copia locale degli allegati ricevuti
MAIL_ARCHIVE_DIR=posta_in_arrivo

# ---------------------------------------------------------------- sicurezza della posta
# le email che non superano i controlli NON vengono caricate: finiscono in MAIL_QUARANTINE_FOLDER della casella
# mittenti autorizzati: indirizzi completi o domini, separati da virgola (vuoto = chiunque, sconsigliato)
MAIL_ALLOWED_SENDERS=
# blocca i mittenti che il server di posta ha segnato come falsificati (SPF/DKIM/DMARC fail)
MAIL_REQUIRE_AUTH=true
# controlla gli allegati con Windows Defender prima del caricamento
MAIL_ANTIVIRUS=true
# dimensione massima di un'email in MB (oltre: quarantena, senza scaricarla)
MAIL_MAX_MB=50
MAIL_QUARANTINE_FOLDER="Bloccate VFP"

# ---------------------------------------------------------------- protocollo delle PEC
# regola personalizzata (espressione regolare, gruppo (?P<n>...) o primo gruppo) provata prima di quelle predefinite.
# Vuota = regole predefinite: "Prot. n. ...", numerazione annuale da 001, PG/aaaa/n, REGISTRO UFFICIALE...
PEC_PROTOCOL_REGEX=

# ---------------------------------------------------------------- smistamento con Claude (Anthropic)
# chiave API (console.anthropic.com), meglio di un progetto dedicato con limite di spesa.
# Ad Anthropic vengono inviati solo nomi di file e cartelle, mai il contenuto dei documenti.
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-opus-5-5

# ---------------------------------------------------------------- invio del report via email
# gli utenti non scaricano il report: lo ricevono via email, sempre in copia all'amministratore
ADMIN_EMAIL=
# smtp oppure graph (Microsoft 365, con l'app Azure della posta e il permesso Mail.Send)
REPORT_SEND_METHOD=smtp
# mittente (vuoto = SMTP_USER oppure GRAPH_MAILBOX)
REPORT_FROM=
# domini ammessi per i destinatari, separati da virgola (vuoto = qualsiasi), es. cosedilspa.com
REPORT_EMAIL_DOMAINS=
SMTP_HOST=
SMTP_PORT=587
# starttls (porta 587) oppure ssl (porta 465): il certificato del server viene sempre verificato
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASSWORD=

# ---------------------------------------------------------------- Microsoft 365 / Outlook (Microsoft Graph)
# app registrata in Azure (Entra ID) con permesso applicativo Mail.ReadWrite e consenso dell'amministratore
# (Mail.Send se si inviano i report con Microsoft 365). Limitare l'app alla sola casella con una
# Application Access Policy di Exchange Online: altrimenti il permesso vale per TUTTE le caselle dell'azienda
GRAPH_TENANT_ID=
GRAPH_CLIENT_ID=
GRAPH_CLIENT_SECRET=
# casella da leggere, es. documenti@cosedilspa.com
GRAPH_MAILBOX=
GRAPH_FOLDER=inbox

# ---------------------------------------------------------------- IMAP generico (Aruba, Gmail con password per app, ...)
IMAP_HOST=
IMAP_PORT=993
IMAP_USER=
IMAP_PASSWORD=
IMAP_FOLDER=INBOX

# ---------------------------------------------------------------- PEC (IMAP): gli allegati vengono presi da postacert.eml
PEC_HOST=
PEC_PORT=993
PEC_USER=
PEC_PASSWORD=
PEC_FOLDER=INBOX
