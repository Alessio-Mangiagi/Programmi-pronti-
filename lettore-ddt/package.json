{
  "name": "lettore-ddt",
  "version": "2.4.0",
  "description": "Cosedil PDF to Excel - Backend Express.js",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "set NODE_ENV=production && node dist/server.js",
    "dev": "set NODE_ENV=development && ts-node src/server.ts",
    "build": "tsc && node scripts/copia-risorse.js && vite build",
    "build:pkg": "npm run build && npx pkg dist/server.js --targets node20-win-x64 --output installer-pkg/build/server.exe",
    "batch": "ts-node src/batch/batchClaude.ts",
    "batch:ollama": "ts-node src/batch/batchOllama.ts",
    "test": "jest",
    "test:e2e": "node e2e/smoke.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint --no-error-on-unmatched-pattern src/**/*.ts src/**/*.tsx static/js/**/*.jsx",
    "lint:fix": "eslint --no-error-on-unmatched-pattern src/**/*.ts src/**/*.tsx static/js/**/*.jsx --fix",
    "format": "prettier --write src/**/*.ts src/**/*.tsx static/js/**/*.jsx",
    "type-check": "tsc --noEmit"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      "dist/batch/pulisci_ddt.py"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "installer-pkg/build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.115.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "multer": "^2.2.0",
    "prom-client": "^15.1.0",
    "session-file-store": "^1.5.0",
    "winston": "^3.15.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^30.0.0",
    "@types/multer": "^2.3.0",
    "@types/node": "^26.6.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/session-file-store": "^1.2.6",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^6.1.2",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-prettier": "^5.5.6",
    "jest": "^30.5.2",
    "jest-extended": "^7.0.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.9",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "supertest": "^7.3.1",
    "ts-jest": "^29.4.14",
    "ts-node": "^10.9.2",
    "typescript": "^7.0.2",
    "vite": "^8.3.3"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}
