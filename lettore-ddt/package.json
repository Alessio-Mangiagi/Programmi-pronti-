{
  "name": "lettore-ddt",
  "version": "2.4.0",
  "description": "Cosedil PDF to Excel - Backend Express.js",
  "main": "dist/server.js",
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "start": "set NODE_ENV=production && node dist/server.js",
    "dev": "set NODE_ENV=development && ts-node src/server.ts",
    "build": "tsc && node scripts/copia-risorse.js && vite build",
    "build:pkg": "npm run build && npx pkg dist/server.js --targets node20-win-x64 --output installer-pkg/build/server.exe",
    "batch": "ts-node src/batch/batchClaude.ts",
    "batch:ollama": "ts-node src/batch/batchOllama.ts",
    "test": "jest",
    "test:e2e": "node e2e/smoke.js",
    "test:watch": "jest --watch",
    "test:coverage": "jest --coverage",
    "lint": "eslint --no-error-on-unmatched-pattern src/**/*.ts src/**/*.tsx static/js/**/*.jsx",
    "lint:fix": "eslint --no-error-on-unmatched-pattern src/**/*.ts src/**/*.tsx static/js/**/*.jsx --fix",
    "format": "prettier --write src/**/*.ts src/**/*.tsx static/js/**/*.jsx",
    "type-check": "tsc --noEmit"
  },
  "pkg": {
    "scripts": "dist/**/*.js",
    "assets": [
      "dist/batch/pulisci_ddt.py"
    ],
    "targets": [
      "node20-win-x64"
    ],
    "outputPath": "installer-pkg/build"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.131.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "exceljs": "^4.4.0",
    "express": "^5.2.1",
    "express-rate-limit": "^7.4.0",
    "express-session": "^1.19.0",
    "helmet": "^8.0.0",
    "multer": "^2.2.0",
    "prom-client": "^15.1.0",
    "session-file-store": "^1.5.0",
    "winston": "^3.15.0",
    "zustand": "^4.5.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.6",
    "@types/express-session": "^1.19.0",
    "@types/jest": "^29.5.14",
    "@types/multer": "^2.2.0",
    "@types/node": "^20.11.24",
    "@types/react": "^19.2.14",
    "@types/react-dom": "^19.2.3",
    "@types/session-file-store": "^1.2.6",
    "@types/supertest": "^2.0.12",
    "@typescript-eslint/eslint-plugin": "^8.59.2",
    "@typescript-eslint/parser": "^8.59.2",
    "@vitejs/plugin-react": "^4.2.1",
    "eslint": "^8.56.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-prettier": "^5.1.3",
    "jest": "^29.7.0",
    "jest-extended": "^7.0.0",
    "playwright": "^1.61.1",
    "prettier": "^3.2.5",
    "react": "^19.2.6",
    "react-dom": "^19.2.6",
    "supertest": "^6.3.4",
    "ts-jest": "^29.4.9",
    "ts-node": "^10.9.2",
    "typescript": "^5.9.3",
    "vite": "^7.0.0"
  },
  "overrides": {
    "qs": "^6.16.0",
    "uuid": "^11.1.1"
  }
}
