{
  "name": "logbook",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Logbook — gestionale ore e presenze dipendenti (ore per fasce e progetti, ferie, permessi, malattia, festività, Excel)",
  "scripts": {
    "predev": "tsx scripts/prepara-db.ts",
    "dev": "concurrently -k -n api,web -c blue,green \"tsx watch --clear-screen=false server/index.ts\" \"vite\"",
    "build": "npm run typecheck && vite build",
    "prestart": "tsx scripts/prepara-db.ts --produzione && vite build --logLevel warn",
    "start": "tsx server/index.ts --produzione",
    "typecheck": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.server.json",
    "test": "vitest run",
    "db:prepara": "tsx scripts/prepara-db.ts",
    "db:migra": "prisma migrate dev",
    "db:seed": "prisma db seed",
    "db:reset": "prisma migrate reset --force && prisma db seed",
    "db:studio": "prisma studio",
    "postinstall": "prisma generate"
  },
  "engines": {
    "node": ">=20.19"
  },
  "overrides": {
    "effect": "^3.22.5",
    "uuid": "^11.1.1"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@fontsource/open-sans": "^5.3.0",
    "@fontsource/ubuntu": "^5.3.0",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "exceljs": "^4.4.0",
    "express": "^5.3.0",
    "nodemailer": "10.4.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router-dom": "^7.18.6",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.5",
    "@types/better-sqlite3": "^9.6.0",
    "@types/express": "^5.0.6",
    "@types/node": "^22.20.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.2.0",
    "better-sqlite3": "^12.11.1",
    "concurrently": "^9.2.5",
    "prisma": "^7.10.1",
    "tailwindcss": "^4.3.5",
    "tsx": "^4.23.15",
    "typescript": "~5.9",
    "vite": "^7.3.8",
    "vitest": "^5.1.1"
  },
  "allowScripts": {
    "better-sqlite3": true,
    "esbuild": true,
    "prisma": true,
    "@prisma/engines": true
  }
}
