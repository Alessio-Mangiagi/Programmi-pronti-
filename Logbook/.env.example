# Logbook — variabili d'ambiente (tutte facoltative).
# Copiare in `.env` solo se serve cambiare un default: l'app parte anche senza.

# Percorso del database SQLite. Default: data/logbook.db dentro la cartella dell'app.
# DATABASE_URL=file:C:/percorso/assoluto/logbook.db

# Porta e indirizzo del backend (API). Il frontend Vite (porta 5210) inoltra /api qui.
# LOGBOOK_API_PORT=3012
# LOGBOOK_API_HOST=127.0.0.1
