# "><(((º> sabusabu <º)))><"
# Logbook — variabili d'ambiente (tutte facoltative).
# Copiare in `.env` solo se serve cambiare un default: l'app parte anche senza.

# Percorso del database SQLite. Default: data/logbook.db dentro la cartella dell'app.
# DATABASE_URL=file:C:/percorso/assoluto/logbook.db

# Produzione (npm start, avvia.bat): un solo server per API e interfaccia.
# LOGBOOK_PORT=5210
# Indirizzo di ascolto: 0.0.0.0 per aprirlo agli altri PC della rete locale.
# HOST=127.0.0.1

# Sviluppo (npm run dev): porta delle API; Vite (porta 5210) inoltra /api qui.
# LOGBOOK_API_PORT=3012

# Primo amministratore, creato SOLO se nel database non ce n'è nessuno attivo. Di norma lo
# chiede l'installatore (InstallaLogbook.exe / InstallaSuite.exe) e non si scrive qui.
# Senza password ne viene generata una a caso, mostrata una volta nella finestra di avvio.
# Una password scritta qui è provvisoria: va cambiata al primo accesso.
# LOGBOOK_ADMIN_USERNAME=admin
# LOGBOOK_ADMIN_PASSWORD=

# Dati di esempio (5 dipendenti, 3 progetti, ore finte) SOLO su un database vuoto.
# Default: sì con "npm run dev", no con "npm start" / avvia.bat (uso vero per HR).
# 1 = caricali sempre (copia dimostrativa), 0 = mai.
# LOGBOOK_DATI_DEMO=

# Cartella dei file caricati (attestati, documenti, documentazione dei progetti).
# Default: data/documenti accanto al database. Va inclusa nel backup.
# LOGBOOK_DOCUMENTI_DIR=

# 1 se Logbook sta dietro HTTPS (es. Caddy della suite): cookie di sessione solo cifrato.
# LOGBOOK_COOKIE_SECURE=1

# --- Proprietario di Logbook (dal 25/11/2026) -------------------------------------------
# Account (username) che vede in Impostazioni "Dati del programma": carica i dati di esempio
# e "Cancella tutti i dati". Deve essere un amministratore. Si cambia solo qui, non
# dall'interfaccia. Vuoto = nessun proprietario, i due comandi non compaiono.
# LOGBOOK_PROPRIETARIO=admin
# Indirizzo che riceve il codice di conferma per cancellare tutti i dati.
# LOGBOOK_PROPRIETARIO_EMAIL=

# --- Invio delle email (codice di conferma) ----------------------------------------------
# Senza LOGBOOK_SMTP_HOST "Cancella tutti i dati" resta spento: il codice non va mai nel log.
# LOGBOOK_SMTP_HOST=
# 587 con starttls (di solito), 465 con ssl.
# LOGBOOK_SMTP_PORT=587
# starttls | ssl | nessuna (default: ssl sulla 465, altrimenti starttls).
# LOGBOOK_SMTP_SICUREZZA=starttls
# LOGBOOK_SMTP_UTENTE=
# LOGBOOK_SMTP_PASSWORD=
# Indirizzo "Da:" (default: LOGBOOK_SMTP_UTENTE).
# LOGBOOK_EMAIL_MITTENTE=

# --- Sicurezza (Giorno 34, 25/11/2026) ------------------------------------------------------
# Cartella delle copie di sicurezza (una al giorno, tenute 30 giorni). Default: data/backup.
# Per essere al riparo da un guasto del disco, puntarla a un altro disco o a una cartella di rete.
# LOGBOOK_BACKUP_DIR=
# 0 = niente codice via email all'accesso degli amministratori da un PC nuovo (default: attivo
# quando la posta è configurata). Serve solo se la posta smette di funzionare.
# LOGBOOK_CODICE_ACCESSO=0

# --- Vercel / PostgreSQL (Giorno 35, 25/11/2026) -----------------------------------------------
# Su Vercel DATABASE_URL è un indirizzo PostgreSQL (postgres://…) e lo imposta la piattaforma
# collegando il database: vedi docs/vercel.md. In locale lasciare il file SQLite.
# Connessioni al database per processo (default 3).
# LOGBOOK_PG_CONNESSIONI=3

# --- Avvisi via email (Giorno 36, 26/11/2026) --------------------------------------------------
# Usano la posta LOGBOOK_SMTP_* qui sopra. Quali mandare e a chi si sceglie in Impostazioni.
# Indirizzo a cui si apre Logbook, scritto in fondo alle email (es. http://192.168.1.10:5210).
# LOGBOOK_INDIRIZZO_PUBBLICO=
