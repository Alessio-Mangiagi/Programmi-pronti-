# "><(((º> sabusabu <º)))><"
# Logbook — variabili d'ambiente (tutte facoltative).
# Copiare in `.env` solo se serve cambiare un default: l'app parte anche senza.

# Percorso del database SQLite. Default: data/logbook.db dentro la cartella dell'app.
# DATABASE_URL=file:C:/percorso/assoluto/logbook.db

# Produzione (npm start, avvia.bat): un solo server per API e interfaccia.
# LOGBOOK_PORT=5210
# Indirizzo di ascolto: 0.0.0.0 per aprirlo agli altri PC della rete locale.
# HOST=127.0.0.1

# Sviluppo (npm run dev): porta delle API; Vite (porta 5210) inoltra /api qui.
# LOGBOOK_API_PORT=3012

# Password dell'admin creato all'avvio SOLO se nel database non ce n'è nessuno attivo.
# LOGBOOK_ADMIN_PASSWORD=

# Dati di esempio (5 dipendenti, 3 progetti, ore finte) SOLO su un database vuoto.
# Default: sì con "npm run dev", no con "npm start" / avvia.bat (uso vero per HR).
# 1 = caricali sempre (copia dimostrativa), 0 = mai.
# LOGBOOK_DATI_DEMO=

# Cartella dei file caricati (attestati, documenti, documentazione dei progetti).
# Default: data/documenti accanto al database. Va inclusa nel backup.
# LOGBOOK_DOCUMENTI_DIR=

# 1 se Logbook sta dietro HTTPS (es. Caddy della suite): cookie di sessione solo cifrato.
# LOGBOOK_COOKIE_SECURE=1
