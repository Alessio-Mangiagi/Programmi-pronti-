{
  "name": "traduttore-pdf-trimble",
  "version": "0.1.0",
  "private": true,
  "description": "Telaio dell'app che legge PDF (PCQ / economici), li traduce in file strutturati e li carica su Trimble via API.",
  "type": "module",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node --watch server.js",
    "test": "node --test",
    "verifica-traduttore": "node tools/verifica-traduttore.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "express": "^5.2.1",
    "multer": "^2.2.0",
    "pdfjs-dist": "^6.4.299",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz"
  }
}
