# Copiare in .env (caricato automaticamente da app/database.py se presente)
DATABASE_URL=postgresql+psycopg://fieldview:fieldview@localhost:5432/fieldview
# DATABASE_URL=sqlite:///./fieldview.db
STORAGE_DIR=./storage
# APP_ENV=production rifiuta chiavi mancanti/corte/segnaposto (l'immagine Docker lo imposta)
APP_ENV=dev
SECRET_KEY=genera-una-chiave-lunga-almeno-32-byte-es-openssl-rand-hex-32
ACCESS_TOKEN_HOURS=12
CORS_ORIGINS=http://localhost:5173
# Notifiche (giorno 27): senza SMTP_HOST le email vanno nel log; NOTIFY_WORKER=thread avvia il worker dentro uvicorn
NOTIFY_WORKER=thread
NOTIFY_INTERVAL=10
WEB_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fieldview@localhost
# EXPO_PUSH_URL= (vuoto = push disattivate); EXPO_ACCESS_TOKEN opzionale
# Inviti: giorni di validità del link (WEB_URL è anche la base del link /invito/<token>)
INVITE_DAYS=7

# Produzione (docker-compose.prod.yml)
# POSTGRES_PASSWORD=...          obbligatoria
# APP_PORT=8000                  porta locale dietro il reverse proxy
# BACKUP_CRON="0 2 * * *"        BACKUP_KEEP=14 (giorni)
# Storage S3-compatible (vuoto = filesystem in STORAGE_DIR / volume appdata)
# STORAGE_S3_BUCKET=fieldview  STORAGE_S3_ENDPOINT=https://s3.eu-central-1.amazonaws.com  STORAGE_S3_REGION=eu-central-1  STORAGE_S3_PREFIX=prod
# AWS_ACCESS_KEY_ID=...  AWS_SECRET_ACCESS_KEY=...
