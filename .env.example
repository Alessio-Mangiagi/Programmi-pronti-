# Copiare in .env (caricato automaticamente da app/database.py se presente)
DATABASE_URL=postgresql+psycopg://fieldview:fieldview@localhost:5432/fieldview
# DATABASE_URL=sqlite:///./fieldview.db
STORAGE_DIR=./storage
SECRET_KEY=genera-una-chiave-lunga-almeno-32-byte-es-openssl-rand-hex-32
ACCESS_TOKEN_HOURS=12
CORS_ORIGINS=http://localhost:5173
# Notifiche (giorno 27): senza SMTP_HOST le email vanno nel log; NOTIFY_WORKER=thread avvia il worker dentro uvicorn
NOTIFY_WORKER=thread
NOTIFY_INTERVAL=10
WEB_URL=http://localhost:5173
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=fieldview@localhost
