# SkyTower sul server aziendale (docker compose): modello del file .env.
# installa.ps1 / installa.sh lo copia in .env e riempie i segreti con valori casuali.
# Il file .env NON va nel repository né condiviso: contiene le password del database e di MinIO.

# ---- Come lo raggiungono i colleghi -------------------------------------------------------------
# Nome o IP del server come lo vedono i browser (senza dominio della suite). Usato per gli URL
# pubblici del web (5195) e dell'S3 (9100): deve essere raggiungibile dai PC dei colleghi.
SKYTOWER_HOST=srv-suite
# Dominio della suite dietro Caddy (deploy/Caddyfile): se impostato, il web è https://skytower.<dominio>
# e l'S3 https://s3-skytower.<dominio> (da aggiungere al Caddyfile della suite, vedi README).
# Vuoto = HTTP diretto in LAN sulle porte qui sotto.
SUITE_DOMINIO=
WEB_PORTA=5195
API_PORTA=8100
S3_PORTA=9100

# Calcolati da installa.* a partire dai valori sopra (non modificare a mano se non sai cosa fai):
#   WEB_ORIGIN           = https://skytower.<dominio>  oppure  http://<host>:5195
#   S3_ENDPOINT_PUBBLICO = https://s3-skytower.<dominio> oppure http://<host>:9100
#   COOKIE_SECURE        = true con https, false in HTTP (altrimenti il browser scarta il cookie di sessione)
#   SKYTOWER_HOST_PUBBLICO / S3_HOST_PUBBLICO = i due nomi, risolti dentro i container verso il server
WEB_ORIGIN=http://srv-suite:5195
S3_ENDPOINT_PUBBLICO=http://srv-suite:9100
COOKIE_SECURE=false
SKYTOWER_HOST_PUBBLICO=skytower.localhost
S3_HOST_PUBBLICO=s3-skytower.localhost
# Con SUITE_DOMINIO: certificato radice del Caddy della suite, perché l'API chiami https://s3-skytower.<dominio>
# fidandosi della CA interna. Cartella sul server che contiene root.crt (montata in /certs) e nome del file.
AWS_CA_BUNDLE_HOST=./certs
AWS_CA_BUNDLE=/etc/ssl/certs/ca-certificates.crt

# ---- Segreti (generati da installa.*) ------------------------------------------------------------
POSTGRES_PASSWORD=
DB_PWD_OWNER=
DB_PWD_APP=
DB_PWD_AUTH=
DB_PWD_WORKER=
MINIO_ROOT_USER=skytower-admin
MINIO_ROOT_PASSWORD=
S3_UTENTE=skytower-app
S3_SEGRETO=
S3_BUCKET=cde-documenti
# Retention di default degli oggetti (giorni, GOVERNANCE); le ancore del registro hanno la loro (10 anni)
S3_LOCK_GIORNI=1
AUDIT_LOCK_MODE=COMPLIANCE
# Console web di MinIO (porta 9001 non pubblicata): on solo per diagnosi
MINIO_CONSOLE=off

# ---- Suite Cosedil --------------------------------------------------------------------------------
# Token di servizio fra le app (shared/suite/.token sul server): installa.* lo copia da lì o lo crea.
SUITE_TOKEN=
# Le altre app girano sul server fuori dai container: host.docker.internal = il server
COSEDIL_PORTAL=http://host.docker.internal:8080
SUITE_URL_INCAMPO=http://host.docker.internal:5190/api
SUITE_URL_MAGAZZINO=http://host.docker.internal:5200/api
SUITE_URL_CONFRONTO=http://host.docker.internal:5001
SUITE_URL_VERIFICA=http://host.docker.internal:5185/api
SUITE_URL_SCADENZARIO=http://host.docker.internal:5180/api
SUITE_URL_PORTALE=http://host.docker.internal:8080/api
# Login dal portale (modules/portale.py): organizzazione e ruolo degli utenti creati al volo
CDE_SUITE_RUOLO_PORTALE=DESIGNER
CDE_SUITE_EMAIL_DOMINIO=cosedilspa.com
# CDE_SUITE_ORG_ID=  (uuid dell'organizzazione; vuoto = quella del primo platform admin)

# ---- Prima installazione (prepara_db.py) ---------------------------------------------------------
ORG_CODICE=COS
ORG_NOME=Cosedil S.p.A.
ADMIN_EMAIL=admin@cosedilspa.com
ADMIN_NOME=Amministratore
ADMIN_COGNOME=SkyTower
# Account personale dell'utente (facoltativo): creato come platform admin e admin dell'organizzazione
ACCOUNT_PERSONALE_EMAIL=
ACCOUNT_PERSONALE_NOME=
ACCOUNT_PERSONALE_COGNOME=
# Le password degli account le chiede installa.* a video (nascoste): non scriverle qui.

# ---- Facoltativi ----------------------------------------------------------------------------------
CDE_MAIL_FROM=SkyTower <no-reply@cosedilspa.com>
# Marca temporale RFC 3161 per le ancore del registro (TSA qualificata eIDAS): vuoto = senza marca
CDE_TSA_URL=
# OnlyOffice Docs (ADR-37): URL come lo vede il browser e segreto JWT del Document Server; vuoti = funzione spenta
CDE_ONLYOFFICE_URL=
CDE_ONLYOFFICE_JWT_SECRET=
# Backup: cartella sul server e giorni di conservazione dei pg_dump
BACKUP_DIR=./backup
BACKUP_GIORNI=30
# Tag delle immagini costruite (aggiorna.* lo mette = commit corrente)
SKYTOWER_VERSIONE=locale
