# SPA di SkyTower servita da Caddy (ADR-43): la build Vite nasce qui dentro, così sul server
# non servono Node né npm. Contesto di build = cartella skytower/ (vedi docker-compose.yml).
#
#   docker build -f infra/docker/Dockerfile.web -t skytower-web .

FROM node:22-alpine AS build
WORKDIR /w
COPY apps/web/package.json apps/web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY apps/web/ ./
# tsc -b + vite build (stesso comando dello sviluppo); dist/ è il risultato
RUN npm run build

FROM caddy:2-alpine
# Caddy ascolta su :80 dentro la rete di compose; il TLS lo fa il Caddy della suite (deploy/Caddyfile)
# o, senza dominio, si resta in HTTP nella LAN (vedi README § Rilascio sul server aziendale).
COPY infra/docker/Caddyfile.web /etc/caddy/Caddyfile
COPY --from=build /w/dist /srv
EXPOSE 80
